# Ejemplo de Envío de Emails
# Creador: MushhX

import email

print("=== Sistema de Envío de Emails ===")
print("")

# Configurar servidor SMTP
configure_smtp("smtp.gmail.com", 587, "usuario@gmail.com", "password")

# Enviar email simple
print("Enviando email simple...")
send("destinatario@example.com", "Hola desde Mux", "Este es un mensaje de prueba")

# Enviar email HTML
print("")
print("Enviando email HTML...")
let html = "<h1>Hola desde Mux</h1><p>Este es un email HTML</p>"
send_html("destinatario@example.com", "Email HTML", html)

# Enviar con adjunto
print("")
print("Enviando email con adjunto...")
send_with_attachment(
    "destinatario@example.com",
    "Documento adjunto",
    "Te envío el documento solicitado",
    "documento.pdf"
)

print("")
print("✅ Emails enviados correctamente")
