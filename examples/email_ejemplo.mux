# Para enviar, define MUX_SEND_SAMPLE_EMAIL=true y MUX_SMTP_* / MUX_EMAIL_TO.

import email
import env

if env.get("MUX_SEND_SAMPLE_EMAIL") == "true"
    email.configure_smtp(
        env.require("MUX_SMTP_HOST"),
        int(env.require("MUX_SMTP_PORT")),
        env.require("MUX_SMTP_USER"),
        env.require("MUX_SMTP_PASSWORD")
    )
    email.send(
        env.require("MUX_EMAIL_TO"),
        "Hola desde Mux",
        "Este mensaje de muestra fue enviado desde Mux"
    )
    print("Mensaje aceptado por el servidor SMTP")
else
    print("Define MUX_SEND_SAMPLE_EMAIL=true y las variables MUX_SMTP_* para enviar un mensaje")
end
