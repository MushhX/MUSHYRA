# Ejemplo de Base de Datos
# Creador: MushhX

import database

print("=== Sistema de Base de Datos ===")
print("")

# Conectar a base de datos
let db = connect("usuarios.db")

# Crear tabla
create_table("usuarios", ["id", "nombre", "email", "edad"])

# Insertar datos
print("Insertando usuarios...")
insert("usuarios", {"nombre": "Ana", "email": "ana@example.com", "edad": 25})
insert("usuarios", {"nombre": "Carlos", "email": "carlos@example.com", "edad": 30})
insert("usuarios", {"nombre": "María", "email": "maria@example.com", "edad": 28})

# Consultar datos
print("")
print("Consultando usuarios...")
let usuarios = select("usuarios", "edad >= 25")
show(usuarios)

# Actualizar datos
print("")
print("Actualizando usuario...")
update("usuarios", {"edad": 26}, "nombre = 'Ana'")

# Eliminar datos
print("")
print("Eliminando usuario...")
delete("usuarios", "nombre = 'Carlos'")

# Cerrar conexión
close(db)

print("")
print("✅ Operaciones de base de datos completadas")
