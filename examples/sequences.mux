import sequence as seq

func doble(valor)
    return valor * 2
end

func es_par(valor)
    return valor % 2 == 0
end

let numeros = [1, 2, 3, 4]
let dobles = seq.map(doble, numeros)
let pares = seq.filter(es_par, numeros)
let positivos = [valor for valor in numeros if valor > 0]
let por_dos = {valor: valor * 2 for valor in numeros}
let {nombre, valores} = {"nombre": "Mux", "valores": numeros}
let (primero, segundo) = seq.zip(numeros, dobles)[0]
let invertidos = numeros[::-1]
numeros[1:3] = [8, 9]

print(dobles)
print(pares)
print(positivos)
print(por_dos)
print(nombre)
print(len(valores))
print([primero, segundo])
print(invertidos)
print(seq.sum(numeros))
