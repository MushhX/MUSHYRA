# Secuencia de Fibonacci en Mux

func fibonacci(n)
    if n <= 1
        return n
    end
    
    let a = 0
    let b = 1
    let contador = 2
    
    while contador <= n
        let temp = a + b
        a = b
        b = temp
        contador = contador + 1
    end
    
    return b
end

print("Primeros 10 números de Fibonacci:")
let i = 0
while i < 10
    print(fibonacci(i))
    i = i + 1
end
