# Bot de Telegram en Mux
# Define MUX_TELEGRAM_TOKEN antes de ejecutarlo.

import telegram_bot
import env

let bot = telegram_bot.crear_bot(env.require("MUX_TELEGRAM_TOKEN"))

func start_handler()
    return "¡Bienvenido al bot de Telegram!"
end

func ayuda_handler()
    return "Comandos disponibles: /start y /ayuda"
end

telegram_bot.comando(bot, "start", start_handler)
telegram_bot.comando(bot, "ayuda", ayuda_handler)
telegram_bot.iniciar_bot(bot)
