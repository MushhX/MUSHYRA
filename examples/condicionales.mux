# Condicionales en Mux

let edad = 20

if edad >= 18
    print("Eres mayor de edad")
end

let temperatura = 25

if temperatura > 30
    print("Hace calor")
else
    print("Temperatura agradable")
end

# Comparaciones
let a = 10
let b = 20

if a < b
    print("a es menor que b")
end

if a == 10
    print("a es igual a 10")
end

if a != b
    print("a es diferente de b")
end
