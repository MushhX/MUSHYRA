# Bot de Discord en MUSHYRA
# Define MYR_DISCORD_TOKEN antes de ejecutarlo.

import discord_bot
import env

let bot = discord_bot.crear_bot(env.require("MYR_DISCORD_TOKEN"))

func saludar_handler()
    return "¡Hola desde Discord!"
end

func info_handler()
    return "Bot creado con MUSHYRA"
end

discord_bot.comando(bot, "hola", saludar_handler)
discord_bot.comando(bot, "info", info_handler)
discord_bot.iniciar_bot(bot)
