# Demo ejecutable: funciones, condiciones y módulos estándar.
import math as matematica
import json as json_mux

func describir_valor(nombre, valor)
    if valor < 0
        let tipo = "negativo"
    else
        let tipo = "cero o positivo"
    end

    return {
        "nombre": nombre,
        "valor": valor,
        "tipo": tipo,
        "raiz": matematica.sqrt(valor)
    }
end

let resultado = describir_valor("Mux", 144)
print("Demo Mux: function + condition + math + JSON")
print(json_mux.stringify(resultado))
