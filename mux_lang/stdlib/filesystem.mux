# Mux File Library
# Creador: MushhX
# Librería para manejo de archivos

func read(ruta)
    print("📖 Leyendo archivo: " + ruta)
    return "Contenido del archivo"
end

func write(ruta, contenido)
    print("✍️ Escribiendo en: " + ruta)
    return true
end

func append(ruta, contenido)
    print("➕ Agregando a: " + ruta)
    return true
end

func exists(ruta)
    print("🔍 Verificando: " + ruta)
    return true
end

func remove_file(ruta)
    print("🗑️ Eliminando: " + ruta)
    return true
end

func list_dir(ruta)
    print("📁 Listando directorio: " + ruta)
    return ["archivo1.txt", "archivo2.txt", "carpeta"]
end

func create_dir(ruta)
    print("📁 Creando directorio: " + ruta)
    return true
end

func get_size(ruta)
    print("📏 Obteniendo tamaño de: " + ruta)
    return 1024
end
