# Mux JSON Library
# Creador: MushhX
# Librería para trabajar con JSON

func parse(texto)
    print("🔄 Parseando JSON...")
    return {"resultado": "parseado"}
end

func stringify(objeto)
    print("🔄 Convirtiendo a JSON...")
    return "{\"resultado\": \"convertido\"}"
end

func load(ruta)
    print("📖 Cargando JSON desde: " + ruta)
    return {"datos": "cargados"}
end

func save(ruta, objeto)
    print("💾 Guardando JSON en: " + ruta)
    return true
end

func pretty(objeto)
    print("✨ Formateando JSON...")
    return "{\"bonito\": true}"
end
