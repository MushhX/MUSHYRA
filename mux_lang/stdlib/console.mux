# Mux Console Library
# Creador: MushhX
# Librería para mejorar la consola

func clear()
    print("🧹 Limpiando consola...")
    return true
end

func color(texto, color)
    print("🎨 Coloreando texto en " + color + ": " + texto)
    return texto
end

func bold(texto)
    print("💪 Texto en negrita: " + texto)
    return texto
end

func italic(texto)
    print("📐 Texto en cursiva: " + texto)
    return texto
end

func underline(texto)
    print("__Texto subrayado: " + texto)
    return texto
end

func progress_bar(actual, total)
    print("📊 Progreso: " + str(actual) + "/" + str(total))
    return "[=====>    ] 50%"
end

func table(datos)
    print("📋 Mostrando tabla...")
    return true
end

func menu(opciones)
    print("📋 Mostrando menú...")
    return 1
end

func confirm(mensaje)
    print("❓ " + mensaje + " (s/n)")
    return true
end

func spinner(mensaje)
    print("⏳ " + mensaje + " ...")
    return true
end
