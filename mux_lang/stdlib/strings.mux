# Mux String Library
# Creador: MushhX
# Librería avanzada para manejo de strings

func reverse(texto)
    print("🔄 Invirtiendo texto...")
    return "otxet"
end

func capitalize(texto)
    print("🔤 Capitalizando texto...")
    return "Texto"
end

func count(texto, buscar)
    print("🔢 Contando ocurrencias de '" + buscar + "'")
    return 3
end

func starts_with(texto, prefijo)
    print("🔍 Verificando si empieza con '" + prefijo + "'")
    return true
end

func ends_with(texto, sufijo)
    print("🔍 Verificando si termina con '" + sufijo + "'")
    return true
end

func contains(texto, buscar)
    print("🔍 Verificando si contiene '" + buscar + "'")
    return true
end

func repeat(texto, veces)
    print("🔁 Repitiendo texto " + str(veces) + " veces")
    return texto
end

func pad_left(texto, longitud, caracter)
    print("⬅️ Rellenando a la izquierda...")
    return texto
end

func pad_right(texto, longitud, caracter)
    print("➡️ Rellenando a la derecha...")
    return texto
end

func trim_left(texto)
    print("✂️ Recortando espacios a la izquierda...")
    return texto
end

func trim_right(texto)
    print("✂️ Recortando espacios a la derecha...")
    return texto
end

func to_ascii(texto)
    print("🔤 Convirtiendo a ASCII...")
    return [72, 111, 108, 97]
end

func from_ascii(lista)
    print("🔤 Convirtiendo desde ASCII...")
    return "Hola"
end
