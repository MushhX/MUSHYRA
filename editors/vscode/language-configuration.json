{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {"open": "{", "close": "}"},
    {"open": "[", "close": "]"},
    {"open": "(", "close": ")"},
    {"open": "\"", "close": "\"", "notIn": ["string"]}
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:if|func|repeat|while|for|each|loop|until|unless|else|elif)\\b|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?\\s+times\\b).*$",
    "decreaseIndentPattern": "^\\s*(?:end|else|elif)\\b.*$"
  }
}
