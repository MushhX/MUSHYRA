{
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:args})",
      "    $0",
      "end"
    ],
    "description": "Create a Mux function"
  },
  "If/else": {
    "prefix": "if",
    "body": [
      "if ${1:condition}",
      "    $2",
      "else",
      "    $0",
      "end"
    ],
    "description": "Create a conditional block"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items}",
      "    $0",
      "end"
    ],
    "description": "Iterate over a collection"
  },
  "Repeat loop": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:count}",
      "    $0",
      "end"
    ],
    "description": "Repeat a block a fixed number of times"
  },
  "Print": {
    "prefix": "print",
    "body": "print(${1:value})",
    "description": "Print a value"
  },
  "Import module": {
    "prefix": "import",
    "body": "import ${1:module} as ${2:alias}",
    "description": "Import a module with an alias"
  }
}
