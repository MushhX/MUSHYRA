{
  "name": "mux-language-support",
  "displayName": "MUSHYRA Language Support",
  "description": "Syntax highlighting and language-server features for MUSHYRA programs",
  "version": "2.0.0",
  "publisher": "mushhx",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": ["onLanguage:mux"],
  "contributes": {
    "configuration": {
      "title": "MUSHYRA",
      "properties": {
        "myr.serverPath": {
          "type": "string",
          "default": "myr",
          "description": "Path to the MUSHYRA executable that starts the language server."
        },
        "myr.serverArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["--lsp"],
          "description": "Arguments used to start the language server."
        },
        "mux.serverPath": {
          "type": "string",
          "default": "mux",
          "description": "Ruta al ejecutable heredado de Mux que inicia el servidor de lenguaje."
        },
        "mux.serverArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["--lsp"],
          "description": "Argumentos usados para iniciar el servidor de lenguaje."
        }
      }
    },
    "languages": [
      {
        "id": "mux",
        "aliases": ["MUSHYRA", "myr", "Mux", "mux"],
        "extensions": [".myr", ".mux"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mux",
        "scopeName": "source.mux",
        "path": "./syntaxes/mux.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mux",
        "path": "./snippets/mux.code-snippets"
      }
    ]
  }
}
